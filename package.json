{
    "name":  "songam-restaurant",
    "version":  "0.3.0",
    "private":  true,
    "engines":  {
                    "node":  "24.13.0"
                },
    "scripts":  {
                    "start":  "node scripts/dev.mjs",
                    "dev":  "node scripts/dev.mjs",
                    "build":  "vite build --configLoader native",
                    "preview":  "vite preview --host 127.0.0.1 --configLoader native",
                    "backend":  "node --env-file=.env server/index.mjs",
                    "setup:manager":  "node --env-file=.env server/setup.mjs",
                    "test":  "node --test tests/*.test.mjs",
                    "frontend":  "vite --host 127.0.0.1 --configLoader native",
                    "db:repair":  "node scripts/repair-database.mjs"
                },
    "dependencies":  {
                         "mysql2":  "^3.15.3",
                         "react":  "17.0.2",
                         "react-dom":  "17.0.2"
                     },
    "devDependencies":  {
                            "vite":  "7.3.6"
                        }
}
